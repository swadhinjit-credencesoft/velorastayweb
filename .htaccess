############################################
# HOSTINGER - NEXT.JS STATIC EXPORT
############################################

Options -Indexes
Options -MultiViews

RewriteEngine On

############################################
# FORCE HTTPS + NON-WWW
############################################

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.shivharehotelsandtravel\.com$ [NC]
RewriteRule ^(.*)$ https://shivharehotelsandtravel.com/$1 [R=301,L]

############################################
# REDIRECT OLD BRAND ROUTES TO NEW HOTEL ROUTES
############################################

RewriteRule ^villas/?$ /rooms [R=301,L]
RewriteRule ^villas/.+ /rooms [R=301,L]
RewriteRule ^facilities/?$ /amenities [R=301,L]
RewriteRule ^facilities/.+ /amenities [R=301,L]
RewriteRule ^nearby/?$ /location [R=301,L]
RewriteRule ^booking/?$ https://bookone.io/Hotel-The-Queen-S-Head-Delhi?bookingEngine=true [R=302,L]
RewriteRule ^book-now/?$ https://bookone.io/Hotel-The-Queen-S-Head-Delhi?bookingEngine=true [R=302,L]
RewriteRule ^food-menu/?$ /restaurant [R=301,L]
RewriteRule ^privacy/?$ /legal/privacy-policy [R=301,L]
RewriteRule ^refund/?$ /legal/cancellation-policy [R=301,L]
RewriteRule ^terms/?$ /legal/terms-and-conditions [R=301,L]
RewriteRule ^(blog|events|offers|tours|explore|search)/?$ / [R=301,L]

############################################
# REMOVE index.html
############################################

RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

############################################
# REMOVE .html FROM URLS
############################################

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^(.+?)\.html$ /$1 [R=301,L]

############################################
# SERVE EXISTING FILES
############################################

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

############################################
# REWRITE CLEAN URLS TO .HTML
############################################

RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

############################################
# CACHE
############################################

<IfModule mod_expires.c>

ExpiresActive On

ExpiresByType text/html "access plus 0 seconds"

ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/javascript "access plus 1 year"

ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/gif "access plus 1 year"

ExpiresByType font/woff2 "access plus 1 year"

ExpiresDefault "access plus 0 seconds"

</IfModule>

############################################
# GZIP
############################################

<IfModule mod_deflate.c>

AddOutputFilterByType DEFLATE text/html
AddOutputFilterByType DEFLATE text/plain
AddOutputFilterByType DEFLATE text/css
AddOutputFilterByType DEFLATE application/javascript
AddOutputFilterByType DEFLATE application/json
AddOutputFilterByType DEFLATE application/xml
AddOutputFilterByType DEFLATE image/svg+xml

</IfModule>

############################################
# SECURITY HEADERS
############################################

<IfModule mod_headers.c>

Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

</IfModule>

############################################
# CUSTOM 404
############################################

ErrorDocument 404 /404.html
