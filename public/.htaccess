############################################
# HOSTINGER / APACHE - NEXT.JS STATIC EXPORT
#
# This file lives in /public so Next.js copies it into
# the exported out/ folder on every build. If it is only
# in the project root it never reaches the server and all
# clean URLs break (/rooms -> 404, /rooms/ -> 403).
############################################

Options -Indexes
Options -MultiViews
DirectoryIndex index.html

RewriteEngine On

############################################
# FORCE HTTPS + NON-WWW
############################################

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.bishnubhaban\.com$ [NC]
RewriteRule ^(.*)$ https://bishnubhaban.com/$1 [R=301,L]

############################################
# REDIRECT LEGACY /villas URLS TO /rooms
############################################

# Retired Velora-era villa slugs, e.g.
# /villas/2-bhk-villa, /villas/5-bhk-grand-villa, /villas/velora-4-bhk-villa
RewriteRule ^villas/(?:velora-)?[0-9]+-bhk-(?:grand-)?villa/?$ /rooms [R=301,L]

# Old invented room slugs, mapped to the closest current room
RewriteRule ^villas/standard-room/?$ /rooms/double-bed-ac-room [R=301,L]
RewriteRule ^villas/deluxe-room/?$ /rooms/deluxe-double-bedded-temple-facing-room [R=301,L]
RewriteRule ^villas/multi-bed-room/?$ /rooms/four-bed-ac-room [R=301,L]

# The listing itself
RewriteRule ^villas/?$ /rooms [R=301,L]

# Any remaining /villas/<slug> keeps its slug under /rooms
RewriteRule ^villas/([^/]+)/?$ /rooms/$1 [R=301,L]

############################################
# STRIP index.html AND .html FROM URLs
############################################

RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^(.+?)\.html$ /$1 [R=301,L]

############################################
# SERVE REAL FILES AS-IS
# Covers /_next/*, /images/*, /sitemap.xml, /robots.txt, /icon.png
############################################

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

############################################
# CLEAN URL -> .HTML
#
# Next.js exports pages as about.html, rooms.html,
# rooms/double-bed-non-ac-room.html and so on, with NO
# index.html inside the rooms/ folder. This block resolves:
#   /rooms/                      -> rooms.html            (was 403)
#   /rooms                       -> rooms.html
#   /rooms/double-bed-non-ac-room -> rooms/double-bed-non-ac-room.html
#   /jamindar-nest               -> jamindar-nest.html    (was 404)
#   /jamindar-nest/              -> jamindar-nest.html
############################################

RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Same rule via REQUEST_FILENAME, as a fallback for hosts that deploy the
# site into a subdirectory where DOCUMENT_ROOT is not the app root.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

############################################
# ERROR PAGES
############################################

ErrorDocument 404 /404.html

############################################
# CACHE
############################################

<IfModule mod_expires.c>

ExpiresActive On

# HTML always revalidates so redeploys reach visitors quickly.
ExpiresByType text/html "access plus 0 seconds"

# Next.js hashes every /_next/static file, so a year is safe and optimal.
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/javascript "access plus 1 year"

# Keep images short (1 week). They are frequently replaced in place,
# and a 1-year cache made swapped images look stale for months.
ExpiresByType image/jpeg "access plus 1 week"
ExpiresByType image/png "access plus 1 week"
ExpiresByType image/webp "access plus 1 week"
ExpiresByType image/svg+xml "access plus 1 week"
ExpiresByType image/gif "access plus 1 week"

# Favicon is replaced in place and must never sit stale for days.
ExpiresByType image/x-icon "access plus 0 seconds"

ExpiresByType font/woff2 "access plus 1 year"

ExpiresDefault "access plus 0 seconds"

</IfModule>

############################################
# GZIP
############################################

<IfModule mod_deflate.c>

AddOutputFilterByType DEFLATE text/html
AddOutputFilterByType DEFLATE text/plain
AddOutputFilterByType DEFLATE text/css
AddOutputFilterByType DEFLATE application/javascript
AddOutputFilterByType DEFLATE application/json
AddOutputFilterByType DEFLATE application/xml
AddOutputFilterByType DEFLATE image/svg+xml

</IfModule>

############################################
# SECURITY HEADERS
############################################

<IfModule mod_headers.c>

Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

# HTML: always revalidate.
<FilesMatch "\.html$">
  Header set Cache-Control "public, no-cache, must-revalidate"
</FilesMatch>

# Favicon: kept fresh so icon swaps show up.
<FilesMatch "\.ico$">
  Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>

# Images: short cache so in-place replacements propagate quickly.
<FilesMatch "\.(jpe?g|png|webp|gif|svg)$">
  Header set Cache-Control "public, max-age=604800"
</FilesMatch>

# Next.js hashed bundles: immutable, cache forever.
<LocationMatch "^/_next/static/.+\.(js|css)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</LocationMatch>

</IfModule>
