# ==============================================================================
# Hotel Yogiraj & Hotel Yogiraj NX — Production Apache Configuration (.htaccess)
# Designed & Optimized for Hostinger (Apache / LiteSpeed Web Server)
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Global Directives & Directory Index
# ------------------------------------------------------------------------------
# Disable directory browsing for security (prevents listing files)
Options -Indexes +FollowSymLinks

# Set default document names for directory requests
DirectoryIndex index.html index.php

# ------------------------------------------------------------------------------
# 1. Rewrites & Canonical Redirects (mod_rewrite)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1.1 Force HTTPS (Redirect HTTP to HTTPS)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 1.2 Canonical Domain (Redirect www to non-www)
  RewriteCond %{HTTP_HOST} ^www\.yogirajhotel\.com$ [NC]
  RewriteRule ^(.*)$ https://yogirajhotel.com/$1 [L,R=301]

  # 1.3 Block Hidden Files and Directories (.git, .env, .next_build, etc.)
  RewriteRule "(^|/)\.(?!well-known)" - [F]

  # 1.4 Legacy & Alias Redirects
  RewriteRule ^hotel-yogiraj/?$ / [R=301,L]
  RewriteRule ^hotel-yogiraj-nx/?$ /yogiraj-nx [R=301,L]

  # 1.5 Serve Existing Real Files directly (css, js, images, avif, webp, svg, pdf, etc.)
  # Note: Exclude directories (-d) here so they do NOT trigger 403 Forbidden!
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 1.6 If a directory is requested and it contains an index.html, serve that index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)/?$ $1/index.html [L]

  # 1.7 Explicit Rewrites for Directory Routes with Root-Level .html files
  # (Prevents 403 Forbidden when /yogiraj-nx or /yogiraj-nx/ is accessed/refreshed)
  RewriteRule ^yogiraj-nx/?$ yogiraj-nx.html [L]
  RewriteRule ^rooms/?$ rooms.html [L]
  RewriteRule ^gallery/?$ gallery.html [L]
  RewriteRule ^yogiraj-nx/rooms/?$ yogiraj-nx/rooms.html [L]

  # 1.8 Clean URLs for single-segment routes: e.g. /about -> /about.html, /contact -> /contact.html
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]

  # 1.9 Clean URLs for multi-segment routes: e.g. /yogiraj-nx/about -> /yogiraj-nx/about.html
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # 1.10 Clean URLs for subdirectories containing index.html: e.g. /yogiraj-nx/ -> /yogiraj-nx/index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# 2. Custom Error Documents
# ------------------------------------------------------------------------------
ErrorDocument 403 /404.html
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# ------------------------------------------------------------------------------
# 3. MIME Types Configuration
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType application/ld+json .jsonld
  AddType text/markdown .md
  AddType text/plain .txt
  AddType application/xml .xml
</IfModule>

# ------------------------------------------------------------------------------
# 4. GZIP / Brotli Compression (mod_deflate)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/eot
</IfModule>

# ------------------------------------------------------------------------------
# 5. Browser Caching & Cache-Control (mod_expires & mod_headers)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML & Manifests (1 hour, revalidate)
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 day"

  # Next.js Static Chunks & JS/CSS (1 year immutable)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Images & Icons (1 month)
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts (1 year)
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # 5.1 Immutable Cache for Next.js Static Assets
  <FilesMatch "\.(css|js|woff2|woff|ttf|otf|avif|webp|png|jpe?g)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # 5.2 Short cache for HTML documents and SEO manifests
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # 5.3 Security Headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

# ------------------------------------------------------------------------------
# 6. Protect Sensitive Files
# ------------------------------------------------------------------------------
<FilesMatch "(package\.json|package-lock\.json|tsconfig\.json|\.env.*|README\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
